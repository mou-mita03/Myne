# Create .env.local from this file. Without these values, the app remains fully usable
# for local EPUBs, but sign-in and cross-device Firebase sync stay unavailable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_URL=http://localhost:3001

# Enable Email/Password and Google providers in Firebase Console > Authentication.
# Add each deployed site domain in Firebase Authentication > Settings > Authorized domains.

# Optional server-only Gemini integration. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Required only for server-side paid-book checkout/webhooks. Keep all of these
# server-only; do not expose them with NEXT_PUBLIC_.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
PAYMENT_WEBHOOK_SECRET=
