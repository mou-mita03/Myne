rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() { return request.auth != null && request.auth.uid == userId; }
      function safePreferences() { return !('preferences' in request.resource.data) || request.resource.data.preferences.keys().hasOnly(['language', 'theme', 'reading']); }
      function safeUpdate() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferences', 'lastLogin', 'updatedAt']); }
      allow read: if isOwner();
      // New browser profiles have an exact safe shape. Privileged values are
      // fixed and may later be administered only by trusted backend code.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'accountStatus', 'createdAt', 'updatedAt', 'lastLogin', 'role', 'preferences'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.accountStatus == 'active'
        && safePreferences();
      // Clients cannot alter identity, roles, subscriptions, payments, or purchases.
      allow update: if isOwner() && safeUpdate() && safePreferences();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
